{
  "name": "rea-from-api",
  "version": "0.3.0",
  "description": "Reverse engineer any API: discover how a website serves its data (publisher catalogs, OpenAPI, framework routes, APIs.guru, Wayback, CT, REA browser capture, jsluice, source maps, GraphQL), prove it with evidence, export OpenAPI 3.1, and generate tested TypeScript/Python clients. CLI + MCP server built on REA.",
  "license": "MIT",
  "author": "Vitor Cavalcante Gomes",
  "type": "module",
  "bin": {
    "rea-from-api": "bin/rea-from-api.mjs"
  },
  "files": [
    "bin",
    "dist",
    "SKILL.md",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.json"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "rea-agents": "6.7.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0"
  },
  "mcpName": "io.github.vitorcgo/rea-from-api",
  "keywords": [
    "api",
    "reverse-engineering",
    "openapi",
    "mcp",
    "mcp-server",
    "agent-skills",
    "rea",
    "api-discovery",
    "schemathesis",
    "codegen",
    "evidence"
  ],
  "homepage": "https://github.com/vitorcgo/rea-from-api#readme",
  "bugs": {
    "url": "https://github.com/vitorcgo/rea-from-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorcgo/rea-from-api.git"
  }
}
